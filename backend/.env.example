# Backend environment variables
# Do NOT commit actual secrets to git.
# Copy this file to .env and fill in your values.

PORT=5000
NODE_ENV=development
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
CLEANUP_INTERVAL_MINUTES=60

# --- JWT (required) ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# --- Redis (required for OTP) ---
# Get a free Redis URL from https://upstash.com
# Use the TLS URL (starts with rediss://) for production
REDIS_URL=redis://127.0.0.1:6379

# --- Email / SMTP (required for OTP emails) ---
# For Gmail: use an App Password (not your real password)
# Get one at: myaccount.google.com → Security → 2-Step Verification → App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# --- MongoDB (optional - uses local JSON files if not set) ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=pdf_extractor
